{
  "ConnectionStrings": {
    "Default": "Data Source=llama-server.db;Default Timeout=30"
  },
  "LlamaServer": {
    "Engine": "llamasharp",
    "EngineUrl": "http://127.0.0.1:8080",
    "ModelDirectory": "LocalModels",
    "LlamaSharpModelDirectory": "LLamaSharp models",
    "LlamaSharpContextSize": 2048,
    "LlamaSharpGpuLayerCount": -1,
    "LlamaSharpThreads": 0,
    "LlamaSharpBatchSize": 512,
    "DocumentsRoot": "AppData/Documents",
    "DocumentMaxFileSizeBytes": 104857600,
    "DocumentUserQuotaBytes": 1073741824,
    "DocumentGlobalQuotaBytes": 10737418240,
    "EmbeddingModelDirectory": "Embedding models",
    "EmbeddingModel": "",
    "DocumentIndexingConcurrency": 1,
    "RagChunkSize": 800,
    "RagChunkOverlap": 120,
    "RagResultCount": 6
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
