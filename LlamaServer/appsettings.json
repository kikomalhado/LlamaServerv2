{
  "ConnectionStrings": {
    "Default": "Data Source=llama-server.db"
  },
  "LlamaServer": {
    "Engine": "llamasharp",
    "EngineUrl": "http://127.0.0.1:8080",
    "ModelDirectory": "LocalModels",
    "LlamaSharpModelDirectory": "LLamaSharp models",
    "LlamaSharpContextSize": 2048,
    "LlamaSharpGpuLayerCount": -1,
    "LlamaSharpThreads": 0,
    "LlamaSharpBatchSize": 512
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
