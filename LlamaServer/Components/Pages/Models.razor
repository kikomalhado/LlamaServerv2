@page "/models"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode())
@inject HttpClient Http
@inject NavigationManager Navigation

<main class="shell">
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-logo">🦙</div>
            <h1 class="sidebar-title">Llama Server</h1>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">
                <a class="nav-item" href="/">
                    <span class="nav-icon">◌</span>
                    Conversas
                </a>
                <a class="nav-item active" href="/models">
                    <span class="nav-icon">◈</span>
                    Modelos
                </a>
                <a class="workspace-nav-item" href="/documents">
                    <span class="workspace-nav-icon">▧</span>
                    <span>Documentos</span>
                </a>
               
            </div>
            
            @if (_isAdmin)
                {
                    <a class="nav-item" href="/settings">
                        <span class="nav-icon">⚙</span>
                        Definições
                    </a>
                }

        </nav>

        <div class="sidebar-footer">
            <div class="user-avatar">@GetAvatarLetter()</div>
            <div class="user-info">
                <p class="user-name">@(_currentUser?.DisplayName ?? "Utilizador")</p>
                <p class="user-role">@(_isAdmin ? "Admin" : "User")</p>
            </div>
            <a href="/account" class="nav-mini-link">Conta</a>
            <form method="post" action="/auth/logout">
                <AntiforgeryToken />
                <button type="submit" class="secondary nav-logout">Sair</button>
            </form>
        </div>
    </aside>

    <section class="page-panel">
        <header class="chat-header">
            <div>
                <p class="eyebrow">Biblioteca local</p>
                <h2 class="chat-title">Modelos</h2>
                <p class="muted">Modelos separados por engine, prontos para futuras funcionalidades.</p>
            </div>
            <div class="engine-status @(_engine?.IsRunning == true ? "online" : "offline")">
                <span></span>
                @(_engine?.IsRunning == true ? "Modelo carregado" : "Motor desligado")
            </div>
        </header>

        <div class="models-content">
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <p class="error">@_error</p>
            }

            @if (_isAdmin && _pathForm is not null)
            {
                <EditForm Model="_pathForm" OnValidSubmit="AddModelFolderAsync" class="settings-card-panel settings-form">
                    <h3>Adicionar pasta</h3>
                    <p class="field-help">Escolhe uma pasta existente onde o servidor deve procurar ficheiros GGUF.</p>
                    <label>
                        Pasta
                        <InputText @bind-Value="_pathForm.Folder" placeholder="Ex.: /modelos ou C:\Modelos" />
                    </label>
                    <label>
                        Para onde?
                        <InputSelect @bind-Value="_pathForm.Target">
                            <option value="llamasharp">LLamaSharp</option>
                            <option value="llama.cpp">llama.cpp</option>
                        </InputSelect>
                    </label>
                    <button type="submit" disabled="@_saving">@(_saving ? "A guardar..." : "Adicionar pasta")</button>
                </EditForm>
            }

            <section class="model-folder">
                <div class="folder-heading">
                    <div class="folder-icon">📁</div>
                    <div>
                        <h3>llama.cpp</h3>
                        <p>@_cppDirectory</p>
                    </div>
                    <span class="folder-count">@_cppModels.Count modelo(s)</span>
                </div>
                @if (_cppModels.Count == 0)
                {
                    <p class="folder-empty">Nenhum `.gguf` nesta pasta.</p>
                }
                else
                {
                    <div class="models-grid">
                        @foreach (var model in _cppModels)
                        {
                            <article class="model-card @(model.IsActive ? "selected" : "")">
                                <div class="model-card-icon">◈</div>
                                <div class="model-card-info">
                                    <h3>@model.Name</h3>
                                    <p>@FormatBytes(model.SizeBytes)</p>
                                </div>
                                @if (model.IsActive)
                                {
                                    <span class="model-badge">Ativo</span>
                                }
                                else
                                {
                                    <button type="button" disabled="@(!_isAdmin || _saving)" @onclick="() => SelectCppModelAsync(model.Name)">
                                        @(_isAdmin ? "Usar modelo" : "Admin necessário")
                                    </button>
                                }
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="model-folder">
                <div class="folder-heading">
                    <div class="folder-icon">📁</div>
                    <div>
                        <h3>LLamaSharp</h3>
                        <p>@_llamaSharpDirectory</p>
                    </div>
                    <span class="folder-count">@_llamaSharpModels.Count modelo(s)</span>
                </div>
                @if (_llamaSharpModels.Count == 0)
                {
                    <p class="folder-empty">Nenhum `.gguf` nesta pasta.</p>
                }
                else
                {
                    <div class="models-grid">
                        @foreach (var model in _llamaSharpModels)
                        {
                            <article class="model-card @(model.IsActive ? "selected" : "")">
                                <div class="model-card-icon">◈</div>
                                <div class="model-card-info">
                                    <h3>@model.Name</h3>
                                    <p>@FormatBytes(model.SizeBytes)</p>
                                </div>
                                @if (_isAdmin)
                                {
                                    <button type="button" class="secondary" disabled="@_saving" @onclick="() => ToggleLlamaSharpAccess(model.Name)">
                                        @(model.IsAllowed ? "Disponível para utilizadores" : "Bloqueado para utilizadores")
                                    </button>
                                }
                                @if (model.IsActive && model.IsAllowed)
                                {
                                    <span class="model-badge">Configurado e disponível</span>
                                }
                                else if (model.IsActive)
                                {
                                    <span class="model-badge">Configurado, mas bloqueado</span>
                                }
                                else if (model.IsAllowed)
                                {
                                    <button type="button" disabled="@_saving" @onclick="() => SelectLlamaSharpModelAsync(model.Name)">
                                        Usar modelo
                                    </button>
                                }
                                else
                                {
                                    <span class="model-badge">Indisponível</span>
                                }
                            </article>
                        }
                    </div>
                }
                @if (_isAdmin && _llamaSharpModels.Count > 0)
                {
                    <div class="management-actions" style="margin-top: 16px;">
                        <button type="button" disabled="@_saving" @onclick="SaveLlamaSharpAccessAsync">
                            @(_saving ? "A guardar..." : "Guardar permissões")
                        </button>
                    </div>
                }
            </section>
        </div>
    </section>
</main>

@code {
    private List<ModelInfo> _cppModels = [];
    private List<ModelInfo> _llamaSharpModels = [];
    private string _cppDirectory = "LocalModels";
    private string _llamaSharpDirectory = "LLamaSharp models";
    private AuthUserDto? _currentUser;
    private EngineStatus? _engine;
    private string? _error;
    private bool _isAdmin;
    private bool _saving;
    private ServerSettingsDto? _serverSettings;
    private LlamaSharpConfig? _llamaSharpSettings;
    private ModelPathForm? _pathForm;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await Http.GetFromJsonAsync<AuthUserDto>("/api/auth/me");
        if (_currentUser is null)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        _isAdmin = string.Equals(_currentUser.Role, UserRole.Admin, StringComparison.OrdinalIgnoreCase);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _serverSettings = await Http.GetFromJsonAsync<ServerSettingsDto>("/api/settings");
        _llamaSharpSettings = await Http.GetFromJsonAsync<LlamaSharpConfig>("/api/settings/llamasharp");
        _cppDirectory = _serverSettings?.ModelDirectory ?? _cppDirectory;
        _llamaSharpDirectory = _llamaSharpSettings?.ModelDirectory ?? _llamaSharpDirectory;
        if (_isAdmin)
        {
            _pathForm ??= new ModelPathForm();
        }
        _cppModels = await Http.GetFromJsonAsync<List<ModelInfo>>("/api/models") ?? [];
        _llamaSharpModels = await Http.GetFromJsonAsync<List<ModelInfo>>("/api/llamasharp/models") ?? [];
        _engine = await Http.GetFromJsonAsync<EngineStatus>("/api/engine/status");
    }

    private async Task AddModelFolderAsync()
    {
        if (_pathForm is null || _serverSettings is null || _llamaSharpSettings is null) return;
        _saving = true;
        _error = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_pathForm.Folder))
            {
                _error = "Indica a pasta dos modelos.";
                return;
            }

            if (string.Equals(_pathForm.Target, "llamasharp", StringComparison.OrdinalIgnoreCase))
            {
                var folders = _llamaSharpSettings.ModelDirectory
                    .Split([';', '\n', '\r'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .ToList();
                if (!folders.Contains(_pathForm.Folder.Trim(), StringComparer.OrdinalIgnoreCase)) folders.Add(_pathForm.Folder.Trim());
                var response = await Http.PutAsJsonAsync("/api/settings/llamasharp", new UpdateLlamaSharpSettingsRequest(
                    string.Join(';', folders), _llamaSharpSettings.ContextSize, _llamaSharpSettings.GpuLayerCount,
                    _llamaSharpSettings.Threads, _llamaSharpSettings.BatchSize));
                if (!response.IsSuccessStatusCode) { _error = "Não foi possível adicionar a pasta LLamaSharp."; return; }
            }
            else
            {
                var response = await Http.PutAsJsonAsync("/api/settings", new UpdateServerSettingsRequest(
                    _serverSettings.Engine, _serverSettings.EngineUrl, _pathForm.Folder.Trim()));
                if (!response.IsSuccessStatusCode) { _error = "Não foi possível adicionar a pasta llama.cpp."; return; }
            }

            _pathForm.Folder = "";
            await LoadAsync();
        }
        finally { _saving = false; }
    }

    private async Task SelectCppModelAsync(string model)
    {
        _saving = true;
        _error = null;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/models/load", new LoadModelRequest(model));
            if (!response.IsSuccessStatusCode)
            {
                _error = $"Não foi possível selecionar o modelo (HTTP {(int)response.StatusCode}).";
                return;
            }

            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SelectLlamaSharpModelAsync(string model)
    {
        _saving = true;
        _error = null;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/llamasharp/models/load", new LoadModelRequest(model));
            if (!response.IsSuccessStatusCode)
            {
                _error = $"Não foi possível selecionar o modelo (HTTP {(int)response.StatusCode}).";
                return;
            }

            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private void ToggleLlamaSharpAccess(string model)
    {
        var index = _llamaSharpModels.FindIndex(candidate => candidate.Name == model);
        if (index >= 0)
        {
            var current = _llamaSharpModels[index];
            _llamaSharpModels[index] = current with { IsAllowed = !current.IsAllowed };
        }
    }

    private async Task SaveLlamaSharpAccessAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            var response = await Http.PutAsJsonAsync(
                "/api/llamasharp/models/access",
                new UpdateLlamaSharpModelAccessRequest(
                    _llamaSharpModels.Where(model => model.IsAllowed).Select(model => model.Name).ToList()));
            if (!response.IsSuccessStatusCode)
            {
                _error = $"Não foi possível guardar as permissões (HTTP {(int)response.StatusCode}).";
                return;
            }

            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private static string FormatBytes(long bytes) => bytes switch
    {
        >= 1_000_000_000 => $"{bytes / 1_000_000_000d:0.##} GB",
        >= 1_000_000 => $"{bytes / 1_000_000d:0.##} MB",
        >= 1_000 => $"{bytes / 1_000d:0.##} KB",
        _ => $"{bytes} B"
    };

    private string GetAvatarLetter() => string.IsNullOrWhiteSpace(_currentUser?.DisplayName)
        ? "U"
        : _currentUser.DisplayName[..1].ToUpperInvariant();

    private sealed class ModelPathForm
    {
        public string Folder { get; set; } = "";
        public string Target { get; set; } = "llamasharp";
    }
}
