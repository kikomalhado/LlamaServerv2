@page "/settings/llamasharp"
@attribute [Authorize(Roles = UserRole.Admin)]
@rendermode @(new InteractiveServerRenderMode())
@inject HttpClient Http
@inject NavigationManager Navigation

<main class="auth-shell">
    <section class="auth-card settings-card">
        <a href="/settings" class="back-link">← Voltar às definições</a>
        <p class="eyebrow">Engine local</p>
        <h1>Definições LLamaSharp</h1>
        <p class="muted">Configura como o LLamaSharp carrega os modelos. A escolha do modelo é feita em Modelos.</p>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <p class="success">@_message</p>
        }
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p class="error">@_error</p>
        }

        @if (_form is null)
        {
            <p class="muted">A carregar definições...</p>
        }
        else
        {
            <EditForm Model="_form" OnValidSubmit="SaveAsync" class="auth-form">
                <label>
                    Pasta dos modelos
                    <InputText @bind-Value="_form.ModelDirectory" />
                    <small class="field-help">Uma pasta por linha ou separada por ;. Por defeito: LlamaServer/LLamaSharp models</small>
                </label>
                <label>
                    Tamanho do contexto
                    <InputNumber @bind-Value="_form.ContextSize" min="256" max="131072" />
                </label>
                <label>
                    Camadas GPU
                    <InputNumber @bind-Value="_form.GpuLayerCount" min="-1" />
                    <small class="field-help">-1 tenta usar todas as camadas CUDA; 0 força CPU.</small>
                </label>
                <label>
                    Threads do CPU
                    <InputNumber @bind-Value="_form.Threads" min="0" />
                    <small class="field-help">0 deixa o LLamaSharp escolher automaticamente.</small>
                </label>
                <label>
                    Tamanho do batch
                    <InputNumber @bind-Value="_form.BatchSize" min="32" max="8192" />
                    <small class="field-help">Valores maiores podem acelerar a GPU, mas usam mais memória.</small>
                </label>
                <button type="submit" disabled="@_saving">
                    @(_saving ? "A guardar..." : "Guardar definições")
                </button>
            </EditForm>
        }
    </section>
</main>

@code {
    private SettingsForm? _form;
    private string? _message;
    private string? _error;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        var settings = await Http.GetFromJsonAsync<LlamaSharpConfig>("/api/settings/llamasharp");
        if (settings is not null)
        {
            _form = new SettingsForm
            {
                ModelDirectory = settings.ModelDirectory,
                ContextSize = checked((int)settings.ContextSize),
                GpuLayerCount = settings.GpuLayerCount,
                Threads = settings.Threads,
                BatchSize = checked((int)settings.BatchSize)
            };
        }
    }

    private async Task SaveAsync()
    {
        if (_form is null)
        {
            return;
        }

        _saving = true;
        _message = null;
        _error = null;
        if (_form.ContextSize is < 256 or > 131072)
        {
            _error = "O contexto deve estar entre 256 e 131072.";
            _saving = false;
            return;
        }

        try
        {
            var response = await Http.PutAsJsonAsync("/api/settings/llamasharp", new UpdateLlamaSharpSettingsRequest(
                _form.ModelDirectory,
                (uint)_form.ContextSize,
                _form.GpuLayerCount,
                _form.Threads,
                (uint)_form.BatchSize));

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                _error = error?.Error ?? "Não foi possível guardar as definições.";
                return;
            }

            _message = "Definições LLamaSharp guardadas.";
        }
        finally
        {
            _saving = false;
        }
    }

    private static string FormatBytes(long bytes) => bytes switch
    {
        >= 1_000_000_000 => $"{bytes / 1_000_000_000d:0.##} GB",
        >= 1_000_000 => $"{bytes / 1_000_000d:0.##} MB",
        >= 1_000 => $"{bytes / 1_000d:0.##} KB",
        _ => $"{bytes} B"
    };

    private sealed class SettingsForm
    {
        public string ModelDirectory { get; set; } = "";
        public int ContextSize { get; set; }
        public int GpuLayerCount { get; set; }
        public int Threads { get; set; }
        public int BatchSize { get; set; }
    }
}
