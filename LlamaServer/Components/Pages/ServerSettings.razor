@page "/settings"
@attribute [Authorize(Roles = UserRole.Admin)]
@rendermode @(new InteractiveServerRenderMode())
@inject HttpClient Http

<main class="shell">
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-logo">🦙</div>
            <h1 class="sidebar-title">Llama Server</h1>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">
                <a class="nav-item" href="/">
                    <span class="nav-icon">◌</span>
                    Conversas
                </a>
                <a class="nav-item" href="/models">
                    <span class="nav-icon">◈</span>
                    Modelos
                </a>
                <a class="nav-item" href="/documents">
                    <span class="nav-icon">▧</span>
                    Documentos
                </a>
            </div>
            
                <a class="nav-item active" href="/settings">
                    <span class="nav-icon">⚙</span>
                    Definições
                </a>
            
        </nav>

        <div class="sidebar-footer">
            <div class="user-avatar">@GetAvatarLetter()</div>
            <div class="user-info">
                <p class="user-name">@(_currentUser?.DisplayName ?? "Utilizador")</p>
                <p class="user-role">@(_isAdmin ? "Admin" : "User")</p>
            </div>
            <a href="/account" class="nav-mini-link">Conta</a>
            <form method="post" action="/auth/logout">
                <AntiforgeryToken />
                <button type="submit" class="secondary nav-logout">Sair</button>
            </form>
        </div>
    </aside>

    <section class="page-panel settings-page">
        <header class="chat-header">
            <div>
                <p class="eyebrow">Administração</p>
                <h2 class="chat-title">Definições do servidor</h2>
                <p class="muted">Configura a engine usada pelo chat. O chat não aparece nesta página.</p>
            </div>
            <div class="engine-status @(_status?.IsRunning == true ? "online" : "offline")">
                <span></span>
                @(_status?.IsRunning == true ? "Motor ligado" : "Motor desligado")
            </div>
        </header>

        <div class="settings-content">
            @if (_form is null)
            {
                <p class="muted">A carregar definições...</p>
            }
            else
            {
                <EditForm Model="_form" OnValidSubmit="SaveAsync" class="settings-form settings-card-panel">
                    <label>
                        Engine ativa
                        <InputSelect @bind-Value="_form.Engine">
                            <option value="llama.cpp">llama.cpp</option>
                            <option value="llamasharp">LLamaSharp</option>
                        </InputSelect>
                    </label>
                    <label>
                        URL do motor llama.cpp
                        <InputText @bind-Value="_form.EngineUrl" />
                        <small class="field-help">Usado apenas quando llama.cpp estiver selecionado.</small>
                    </label>
                    <label>
                        Pasta de modelos llama.cpp
                        <InputText @bind-Value="_form.ModelDirectory" />
                    </label>
                    <div class="management-actions">
                        <button type="submit" disabled="@_saving">
                            @(_saving ? "A guardar..." : "Guardar definições")
                        </button>
                        <button type="button" class="secondary" @onclick="TestEngineAsync">Testar motor</button>
                        <a class="secondary settings-link" href="/settings/llamasharp">Configurar LLamaSharp</a>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_message))
                    {
                        <p class="success">@_message</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <p class="error">@_error</p>
                    }
                </EditForm>
            }
            @if (_documentsForm is not null)
            {
                <EditForm Model="_documentsForm" OnValidSubmit="SaveDocumentsAsync" class="settings-form settings-card-panel">
                    <h3>Documentos e RAG</h3>
                    <label>Pasta de documentos<InputText @bind-Value="_documentsForm.DocumentsRoot" /></label>
                    <label>Modelo de embeddings GGUF<InputText @bind-Value="_documentsForm.EmbeddingModel" /><small class="field-help">Nome do ficheiro dentro da pasta de embeddings.</small></label>
                    <label>Pasta de modelos de embeddings<InputText @bind-Value="_documentsForm.EmbeddingModelDirectory" /></label>
                    <label>Tamanho máximo por ficheiro (bytes)<InputNumber @bind-Value="_documentsForm.MaxFileSizeBytes" /></label>
                    <label>Quota por utilizador (bytes)<InputNumber @bind-Value="_documentsForm.UserQuotaBytes" /></label>
                    <label>Quota global (bytes)<InputNumber @bind-Value="_documentsForm.GlobalQuotaBytes" /></label>
                    <label>Concorrência da indexação<InputNumber @bind-Value="_documentsForm.IndexingConcurrency" /></label>
                    <label>Tamanho do chunk (tokens)<InputNumber @bind-Value="_documentsForm.ChunkSize" /></label>
                    <label>Sobreposição (tokens)<InputNumber @bind-Value="_documentsForm.ChunkOverlap" /></label>
                    <label>Resultados RAG<InputNumber @bind-Value="_documentsForm.ResultCount" /></label>
                    <button type="submit" disabled="@_savingDocuments">@(_savingDocuments ? "A guardar..." : "Guardar RAG")</button>
                    @if (!string.IsNullOrWhiteSpace(_documentsMessage)) { <p class="success">@_documentsMessage</p> }
                    @if (!string.IsNullOrWhiteSpace(_documentsError)) { <p class="error">@_documentsError</p> }
                </EditForm>
            }
        </div>
    </section>
</main>

@code {
    private SettingsForm? _form;
    private EngineStatus? _status;
    private AuthUserDto? _currentUser;
    private bool _isAdmin;
    private string? _message;
    private string? _error;
    private bool _saving;
    private DocumentSettingsForm? _documentsForm;
    private bool _savingDocuments;
    private string? _documentsMessage;
    private string? _documentsError;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await Http.GetFromJsonAsync<AuthUserDto>("/api/auth/me");
        _isAdmin = string.Equals(_currentUser?.Role, UserRole.Admin, StringComparison.OrdinalIgnoreCase);
        var settings = await Http.GetFromJsonAsync<ServerSettingsDto>("/api/settings");
        if (settings is not null)
        {
            _form = new SettingsForm
            {
                Engine = settings.Engine,
                EngineUrl = settings.EngineUrl,
                ModelDirectory = settings.ModelDirectory
            };
        }

        var documentSettings = await Http.GetFromJsonAsync<DocumentSettingsDto>("/api/settings/documents");
        if (documentSettings is not null)
        {
            _documentsForm = new DocumentSettingsForm
            {
                DocumentsRoot = documentSettings.DocumentsRoot,
                MaxFileSizeBytes = documentSettings.MaxFileSizeBytes,
                UserQuotaBytes = documentSettings.UserQuotaBytes,
                GlobalQuotaBytes = documentSettings.GlobalQuotaBytes,
                EmbeddingModelDirectory = documentSettings.EmbeddingModelDirectory,
                EmbeddingModel = documentSettings.EmbeddingModel,
                IndexingConcurrency = documentSettings.IndexingConcurrency,
                ChunkSize = documentSettings.ChunkSize,
                ChunkOverlap = documentSettings.ChunkOverlap,
                ResultCount = documentSettings.ResultCount
            };
        }

        await TestEngineAsync();
    }

    private async Task SaveAsync()
    {
        if (_form is null)
        {
            return;
        }

        _saving = true;
        _message = null;
        _error = null;
        try
        {
            var response = await Http.PutAsJsonAsync("/api/settings", new UpdateServerSettingsRequest(
                _form.Engine,
                _form.EngineUrl,
                _form.ModelDirectory));

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                _error = error?.Error ?? "Não foi possível guardar as definições.";
                return;
            }

            _message = "Definições guardadas.";
            await TestEngineAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task TestEngineAsync()
    {
        _status = await Http.GetFromJsonAsync<EngineStatus>("/api/engine/status");
    }

    private async Task SaveDocumentsAsync()
    {
        if (_documentsForm is null) return;
        _savingDocuments = true; _documentsMessage = null; _documentsError = null;
        try
        {
            var response = await Http.PutAsJsonAsync("/api/settings/documents", new UpdateDocumentSettingsRequest(
                _documentsForm.DocumentsRoot, _documentsForm.MaxFileSizeBytes, _documentsForm.UserQuotaBytes,
                _documentsForm.GlobalQuotaBytes, _documentsForm.EmbeddingModelDirectory, _documentsForm.EmbeddingModel,
                _documentsForm.IndexingConcurrency, _documentsForm.ChunkSize, _documentsForm.ChunkOverlap, _documentsForm.ResultCount));
            if (!response.IsSuccessStatusCode) { _documentsError = (await response.Content.ReadFromJsonAsync<ErrorResponse>())?.Error ?? "Não foi possível guardar as definições RAG."; return; }
            _documentsMessage = "Definições RAG guardadas.";
        }
        finally { _savingDocuments = false; }
    }

    private sealed class SettingsForm
    {
        public string Engine { get; set; } = "llama.cpp";
        public string EngineUrl { get; set; } = "";
        public string ModelDirectory { get; set; } = "";
    }

    private sealed class DocumentSettingsForm
    {
        public string DocumentsRoot { get; set; } = "AppData/Documents";
        public long MaxFileSizeBytes { get; set; }
        public long UserQuotaBytes { get; set; }
        public long GlobalQuotaBytes { get; set; }
        public string EmbeddingModelDirectory { get; set; } = "Embedding models";
        public string EmbeddingModel { get; set; } = "";
        public int IndexingConcurrency { get; set; } = 1;
        public int ChunkSize { get; set; } = 800;
        public int ChunkOverlap { get; set; } = 120;
        public int ResultCount { get; set; } = 6;
    }
    
    private string GetAvatarLetter() => string.IsNullOrWhiteSpace(_currentUser?.DisplayName)
        ? "U"
        : _currentUser.DisplayName[..1].ToUpperInvariant();
}
